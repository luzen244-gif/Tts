<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>LzKeyMap</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>LzKeyMap</ApplicationTitle>
    <ApplicationId>com.lz.keymap</ApplicationId>
    <ApplicationDisplayVersion>2.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <!-- API 26: gestos contínuos (dispatchGesture willContinue) e canais de notificação -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <!--
    Shizuku (opcional): baixe api-13.1.5.aar e provider-13.1.5.aar (Maven: dev.rikka.shizuku) para libs/ e descomente.
    Sem as .aar o ShizukuInputExecutor continua compilando e reporta "Unsupported" com a explicação (de propósito).
  <ItemGroup>
    <AndroidLibrary Include="libs\api-13.1.5.aar" Bind="false" />
    <AndroidLibrary Include="libs\provider-13.1.5.aar" Bind="false" />
  </ItemGroup>
  -->

</Project>
